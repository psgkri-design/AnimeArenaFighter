; Engine configuration file.
; Anime Arena Fighter prototype
config_version=5

[application]
config/name="Anime Arena Fighter"
run/main_scene="res://scenes/main.tscn"
config/features=PackedStringArray("4.7", "GL Compatibility")

[display]
window/size/viewport_width=1920
window/size/viewport_height=1080
window/size/window_width_override=1280
window/size/window_height_override=720
window/stretch/mode="canvas_items"
window/handheld/orientation=3

[rendering]
renderer/rendering_method="gl_compatibility"
renderer/rendering_method.mobile="gl_compatibility"
textures/default_filters/use_nearest_mipmap_filter=false
textures/vram_compression/import_etc2_astc=true
anti_aliasing/quality/msaa_3d=2

[physics]
common/physics_ticks_per_second=60
3d/default_gravity=24.0

[input]
move_left={"deadzone":0.2,"events":[Object(InputEventKey,"physical_keycode":65),Object(InputEventJoypadMotion,"axis":0,"axis_value":-1.0)]}
move_right={"deadzone":0.2,"events":[Object(InputEventKey,"physical_keycode":68),Object(InputEventJoypadMotion,"axis":0,"axis_value":1.0)]}
move_forward={"deadzone":0.2,"events":[Object(InputEventKey,"physical_keycode":87),Object(InputEventJoypadMotion,"axis":1,"axis_value":-1.0)]}
move_back={"deadzone":0.2,"events":[Object(InputEventKey,"physical_keycode":83),Object(InputEventJoypadMotion,"axis":1,"axis_value":1.0)]}
jump={"deadzone":0.2,"events":[Object(InputEventKey,"physical_keycode":32),Object(InputEventJoypadButton,"button_index":0)]}
attack={"deadzone":0.2,"events":[Object(InputEventKey,"physical_keycode":74),Object(InputEventJoypadButton,"button_index":2)]}
heavy={"deadzone":0.2,"events":[Object(InputEventKey,"physical_keycode":75),Object(InputEventJoypadButton,"button_index":3)]}
dash={"deadzone":0.2,"events":[Object(InputEventKey,"physical_keycode":16777237),Object(InputEventJoypadButton,"button_index":5)]}
dodge={"deadzone":0.2,"events":[Object(InputEventKey,"physical_keycode":76),Object(InputEventJoypadButton,"button_index":1)]}
block={"deadzone":0.2,"events":[Object(InputEventKey,"physical_keycode":73),Object(InputEventJoypadButton,"button_index":4)]}
lock_on={"deadzone":0.2,"events":[Object(InputEventKey,"physical_keycode":79),Object(InputEventJoypadButton,"button_index":10)]}
skill_1={"deadzone":0.2,"events":[Object(InputEventKey,"physical_keycode":49)]}
skill_2={"deadzone":0.2,"events":[Object(InputEventKey,"physical_keycode":50)]}
skill_3={"deadzone":0.2,"events":[Object(InputEventKey,"physical_keycode":51)]}
skill_4={"deadzone":0.2,"events":[Object(InputEventKey,"physical_keycode":52)]}
ultimate={"deadzone":0.2,"events":[Object(InputEventKey,"physical_keycode":85),Object(InputEventJoypadButton,"button_index":7)]}
pause={"deadzone":0.2,"events":[Object(InputEventKey,"physical_keycode":4194305)]}

[layer_names]
3d_physics/layer_1="World"
3d_physics/layer_2="Fighter"
3d_physics/layer_3="Hurtbox"
3d_physics/layer_4="Hitbox"
3d_physics/layer_5="Projectile"
