shader_type spatial;
render_mode unshaded, cull_disabled;
uniform vec4 energy_color : source_color = vec4(0.1,0.7,1.0,1.0);
void fragment(){
    float rim = pow(1.0 - max(dot(NORMAL, VIEW), 0.0), 2.0);
    ALBEDO = energy_color.rgb;
    EMISSION = energy_color.rgb * (1.6 + rim * 2.2);
    ALPHA = energy_color.a;
}
